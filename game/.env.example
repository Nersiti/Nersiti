# Скопируй в .env и заполни: cp .env.example .env

ENV=prod
# Только для локальной разработки! В проде всегда false.
DEV_MODE=false

# Токен от @BotFather и username бота без @
BOT_TOKEN=123456789:replace-me
BOT_USERNAME=world_battle_bot
# Случайная строка (A-Z, a-z, 0-9, _ и -), например: openssl rand -hex 32
WEBHOOK_SECRET=replace-me

# Домен (или поддомен), направленный A-записью на IP твоего VPS
DOMAIN=game.example.com

# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

GAME_NAME=Битва за Мир

POSTGRES_USER=game
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=game

# Реклама за вознаграждение (этап 10)
ADSGRAM_BLOCK_ID=
ADS_CALLBACK_SECRET=
