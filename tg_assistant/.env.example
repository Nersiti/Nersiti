# Получить на https://my.telegram.org -> API development tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Пароль для входа в локальную веб-панель
DASHBOARD_PASSWORD=change_me
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Общий секрет для связи мод-клиента (телефон) с бэкендом (sync-API)
SYNC_TOKEN=change_me_long_random

# Ключ Claude (необязательно): включает умного ИИ-ассистента вместо локальной модели
ANTHROPIC_API_KEY=
