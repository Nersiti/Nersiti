# ============================================================
#  Nersiti AI — настройки. Скопируй в .env и заполни.
#  cp .env.example .env
# ============================================================

# --- Telegram (обязательно) ---
# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here
# Твой Telegram ID (узнать: напиши боту /id). Несколько — через запятую.
ADMIN_IDS=123456789
BOT_NAME=Nersiti AI
# Куда писать по вопросам оплаты (показывается в /paysupport)
SUPPORT_CONTACT=@your_username
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# База данных. По умолчанию — SQLite-файл в ./data (хватает на десятки тысяч пользователей).
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# PostgreSQL (docker compose --profile postgres):
# DATABASE_URL=postgresql+asyncpg://bot:change_me_please@postgres:5432/bot

# --- Текстовая нейросеть ---
# LLM_BACKEND=mock — заглушка «эхо» для проверки бота без нейросети
LLM_BACKEND=openai
# Любой OpenAI-совместимый API:
#   Ollama на этом же компьютере:        http://localhost:11434/v1
#   Ollama на ПК с RTX через Tailscale:  http://100.x.x.x:11434/v1
#   Бот в Docker, Ollama на хосте:       http://host.docker.internal:11434/v1
#   DeepSeek:   https://api.deepseek.com/v1          (LLM_MODEL=deepseek-chat)
#   OpenRouter: https://openrouter.ai/api/v1         (LLM_MODEL=deepseek/deepseek-chat и др.)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1500
LLM_CONCURRENCY=4
# Ответ «печатается» на глазах у пользователя (если Telegram поддерживает для бота)
LLM_STREAM=true
# Сколько последних сообщений помнит бот
HISTORY_FREE=6
HISTORY_PREMIUM=20
# Свой системный промпт (необязательно):
# LLM_SYSTEM_PROMPT=Ты — {bot_name}, ...

# --- Генерация картинок ---
# comfyui (рекомендуется для RTX 50xx) | a1111 (Forge/A1111 с --api) | openai (внешний API) | mock (заглушка)
IMAGE_BACKEND=comfyui
IMAGE_API_URL=http://localhost:8188
IMAGE_API_KEY=
# Для comfyui/a1111 — имя файла модели (checkpoint); для openai — имя модели (например gpt-image-1)
IMAGE_MODEL=sd_xl_base_1.0.safetensors
# Workflow ComfyUI: workflows/sdxl.json или workflows/flux_schnell.json
COMFY_WORKFLOW=workflows/sdxl.json
IMAGE_STEPS=28
IMAGE_CFG=6.0
# 1.0 — размеры SDXL/Flux (1024px); 0.5 — для моделей SD 1.5 (512px)
IMAGE_SIZE_SCALE=1.0
# Переводить русские описания на английский через LLM (картинки получаются заметно лучше)
IMAGE_TRANSLATE=true
# Сколько картинок генерировать одновременно (для одной видеокарты — 1)
IMAGE_WORKERS=1
IMAGE_TIMEOUT=300

# --- Экономика (лимиты и цены в кредитах) ---
FREE_CHAT_PER_DAY=15
FREE_IMAGES_PER_DAY=3
PREMIUM_CHAT_PER_DAY=500
PREMIUM_IMAGES_PER_DAY=60
CHAT_COST=1
IMAGE_COST=5
START_BONUS=10
REF_BONUS_INVITER=15
REF_BONUS_INVITEE=10
REF_PERCENT=10
DAILY_BONUS=3
# Показывать рекламу (/setad) бесплатным пользователям каждые N ответов (0 — никогда)
AD_EVERY=5

# --- Оплата ---
# Telegram Stars работают сразу, ничего подключать не нужно.
STARS_ENABLED=true

# Рубли внутри Telegram: @BotFather → твой бот → Payments → ЮKassa (или другой провайдер) → токен сюда
RUB_PROVIDER_TOKEN=
# Передавать данные для чека 54-ФЗ (нужно ИП/ООО; самозанятым обычно не нужно)
RUB_RECEIPT=false
RUB_VAT_CODE=1

# Рубли через ЮKassa напрямую (ссылка на оплату картой/СБП): shopId и секретный ключ из личного кабинета
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты — ссылка на бота
YOOKASSA_RETURN_URL=https://t.me/your_bot
# E-mail для чека (если в ЮKassa включены чеки)
YOOKASSA_RECEIPT_EMAIL=

# --- Продвижение ---
# Обязательная подписка на каналы для бесплатных пользователей (бот — админ канала!).
# Формат: @channel1,@channel2  или  -1001234567890|https://t.me/+invite
# Можно менять прямо из бота: /channels
REQUIRED_CHANNELS=
# Канал-витрина: бот сам публикует туда картинки со ссылкой на себя (бот — админ канала!)
SHOWCASE_CHANNEL=
SHOWCASE_INTERVAL_MINUTES=180
