# ============================================================
#  «Хозяин Слова» — настройки. Скопируй в .env и заполни.
#  cp .env.example .env
# ============================================================

# --- Telegram (обязательно) ---
# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here
# Твой Telegram ID (узнать: напиши боту /id). Несколько — через запятую.
ADMIN_IDS=123456789
BOT_NAME=Хозяин Слова
# Куда писать по вопросам оплаты (показывается в /paysupport)
SUPPORT_CONTACT=@your_username
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# База данных. По умолчанию — SQLite-файл в ./data.
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# PostgreSQL (docker compose --profile postgres):
# DATABASE_URL=postgresql+asyncpg://bot:change_me_please@postgres:5432/bot

# --- Текстовая нейросеть: придумывает существ и комментирует бои ---
# LLM_BACKEND=mock — без нейросети (существа генерируются по шаблону)
LLM_BACKEND=openai
# Любой OpenAI-совместимый API:
#   Ollama на этом же компьютере:        http://localhost:11434/v1
#   Ollama на ПК с RTX через Tailscale:  http://100.x.x.x:11434/v1
#   Бот в Docker, Ollama на хосте:       http://host.docker.internal:11434/v1
#   DeepSeek:   https://api.deepseek.com/v1          (LLM_MODEL=deepseek-chat)
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=90
LLM_CONCURRENCY=4

# --- Художник карт (видеокарта) ---
# comfyui (рекомендуется для RTX 50xx) | a1111 (Forge/A1111 с --api) | openai (внешний API) | mock (заглушка)
IMAGE_BACKEND=comfyui
IMAGE_API_URL=http://localhost:8188
IMAGE_API_KEY=
# Для comfyui/a1111 — файл модели (checkpoint); для openai — имя модели
IMAGE_MODEL=sd_xl_base_1.0.safetensors
# workflows/sdxl.json или workflows/flux_schnell.json
COMFY_WORKFLOW=workflows/sdxl.json
IMAGE_STEPS=26
IMAGE_CFG=6.0
# 1.0 — SDXL/Flux (1024px); 0.5 — модели SD 1.5 (512px)
IMAGE_SIZE_SCALE=1.0
# Одна видеокарта — один поток
IMAGE_WORKERS=1
IMAGE_TIMEOUT=300

# --- Экономика (💎 кристаллы) ---
START_CRYSTALS=30
FREE_QUILLS_PER_DAY=3
LORD_QUILLS_PER_DAY=10
QUILL_PRICE=15
FREE_BATTLES_PER_DAY=5
LORD_BATTLES_PER_DAY=30
BATTLE_PRICE=3
DAILY_BONUS=5
IMMUNITY_HOURS=48
SHIELD_DAYS=3
SHIELD_PERCENT=25
FEE_PERCENT=10
LORD_FEE_PERCENT=5
OFFER_TTL_HOURS=24
LORD_BONUS_CRYSTALS=100
REF_BONUS_INVITER=30
REF_BONUS_INVITEE=15
REF_PERCENT=10
# Сколько реферальных наград в день максимум (защита от ферм фейковых аккаунтов)
REF_DAILY_CAP=20
# Реклама (/setad) игрокам без статуса Лорда каждые N боёв (0 — выключить)
AD_EVERY=4
# Первое слово игрока — минимум редкое (сразу маленькая победа)
FIRST_WORD_RARE=true
# Последнее слово игрока нельзя захватить (никто не останется ни с чем)
LAST_WORD_PROTECTED=true

# --- Удержание ---
# Напоминание, если игрок не заходил N дней (не чаще раза в REMIND_EVERY_DAYS)
REMINDERS_ENABLED=true
REMIND_AFTER_DAYS=3
REMIND_EVERY_DAYS=7
# Турнир недели: призы за 1, 2, 3 место (кристаллы), итоги — в ночь на понедельник
TOURNAMENT_ENABLED=true
TOURNAMENT_PRIZES=300,150,75

# --- Аукцион «горячих» слов (список: app/game/reserved_words.txt) ---
AUCTION_ENABLED=true
AUCTION_START_HOUR=12
AUCTION_END_HOUR=21
AUCTION_MIN_BID=50
AUCTION_STEP_PERCENT=10
AUCTION_SNIPE_MINUTES=5

# --- Оплата ---
# Telegram Stars работают сразу, ничего подключать не нужно.
STARS_ENABLED=true
# Рубли внутри Telegram: @BotFather → бот → Payments → ЮKassa (или другой провайдер) → токен сюда
RUB_PROVIDER_TOKEN=
RUB_RECEIPT=false
RUB_VAT_CODE=1
# Рубли через ЮKassa напрямую (ссылка на оплату картой/СБП)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot
YOOKASSA_RECEIPT_EMAIL=

# --- Продвижение ---
# Канал «Хроника мира слов»: бот сам постит туда легендарные карты, захваты и аукционы (бот — админ канала!)
NEWS_CHANNEL=
# Обязательная подписка на каналы для бесплатных игроков (бот — админ канала!). Можно менять из бота: /channels
REQUIRED_CHANNELS=
